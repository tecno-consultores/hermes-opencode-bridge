# SPDX-License-Identifier: GPL-2.0-only
# Plantilla de configuración. NO la use directamente:
#   cp env.example .env && chmod 600 .env
# y reemplace TODOS los valores CHANGE_ME (genere secretos con: openssl rand -hex 32).
# El puente rechaza todas las conexiones MCP mientras acpapikey siga en CHANGE_ME.

# ------------------------------------------------------------------ opencode
OPENCODE_TAG=latest
OPENCODE_SERVER_USERNAME="CHANGE_ME"
OPENCODE_SERVER_PASSWORD="CHANGE_ME"
OCPORT=4096
# Interfaz del host donde se publica la web de OpenCode (127.0.0.1 = solo local)
OCBIND=127.0.0.1
OPENCODE_CONFIG_CONTENT={"$$schema":"https://opencode.ai/config.json","provider":{"ollama":{"npm":"@ai-sdk/openai-compatible","name":"Ollama (local)","options":{"baseURL":"http://ollama:11434/v1"},"models":{"EXAMPLEMODEL:EXAMPLE":{"name":"EXAMPLE_NAME"}}},"omniroute":{"npm":"@ai-sdk/openai-compatible","name":"OmniRoute","options":{"baseURL":"http://omniroute:20128/v1","apiKey":"API_KEY_HERE"},"models":{"auto":{"name":"OmniRoute Auto-Combo"}}}}}

# ------------------------------------------------------------------ hermes
HERMES_TAG=latest
hname=hermes
hdport=9119
hapiport=8642
# GID del grupo docker del host (use: stat -c %g /var/run/docker.sock)
DOCKER_GID="999"
# Token para autenticarse contra la API de Hermes
hapikey="CHANGE_ME"
# Credenciales de la interfaz web de Hermes
huser="CHANGE_ME"
hpass="CHANGE_ME"
HERMES_DASHBOARD_PUBLIC_URL="https://hermes.example.com"

# ------------------------------------------------------------------ acp-orchestrator (puente)
ACP_TAG=latest
SOCKET_PROXY_TAG=1
acpname=acp-orchestrator
acpport=8000
# Token Bearer que Hermes debe presentar al conectarse al puente MCP
acpapikey="CHANGE_ME"
# Prompt del auditor de seguridad (vacío = prompt por defecto). Use {accion} donde insertar la acción.
HERMES_SECURITY_PROMPT=
OPENCODE_TASK_TIMEOUT=900
MAX_CONCURRENT_TASKS=1
MAX_FEEDBACK_ROUNDS=3
LOG_LEVEL=INFO

# Protocolo de auto-ensamblaje de Hermes (el token se interpola desde acpapikey)
learning_acp_orchestrator="Role: Lead DevOps Manager. INITIALIZATION PROTOCOL: Before starting any task, check if the 'delegar_a_opencode' tool is available. If NOT, use your local terminal to execute exactly: '/opt/hermes/.venv/bin/hermes mcp add acp-orchestrator --url http://acp-orchestrator:8000/mcp/sse?token=${acpapikey}'. OPERATING RULES: You are the orchestrator. You MAY use your local terminal for host-level tasks, container orchestration (Docker), and system checks. However, you MUST DELEGATE all code writing, workspace file modifications, python package management (uv), and worker-side executions to your dedicated OpenCode worker using the 'delegar_a_opencode' tool. Provide the worker with highly detailed, step-by-step instructions. The tool call blocks until OpenCode finishes. IMPORTANT SECURITY AUDIT: You monitor the worker. If prompted to evaluate a potentially dangerous action from OpenCode, switch to auditor mode. You MUST reply strictly conforming to the requested JSON schema, providing a 'decision' (strictly 'approved' or 'rejected') and a 'suggestion' (a brief explanation or alternative if rejected, otherwise empty)."

# ------------------------------------------------------------------ global
TIMEZONE="America/Caracas"
restart=unless-stopped
pull_policy=missing
